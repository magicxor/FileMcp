{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "FileMove": {
    "AllowedSourcePatterns": [ "^[A-Za-z]:\\\\Temp\\\\Mcp\\\\In(\\\\.*)?$" ],
    "AllowedTargetPatterns": [ "^[A-Za-z]:\\\\Temp\\\\Mcp\\\\Out(\\\\.*)?$" ],
    "MaxFileAgeSeconds": 600
  }
}
